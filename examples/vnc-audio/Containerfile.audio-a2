# =============================================================================
# Option A2: OPUS packets over a byte stream.
#
# The server encodes the sink monitor to Opus and frames each packet on the
# socket; the browser hands those packets to WebCodecs' AudioDecoder and feeds
# the decoded samples into the same AudioWorklet the A1 example uses.
#
#   pulsesrc <sink>.monitor -> opusenc -> rtpopuspay -> rtpstreampay
#                                                    -> tcpserversink :5901
#
# The framing is not bespoke: rtpstreampay is RFC 4571 (a 2-byte big-endian
# length before each RTP packet), which is the standard way to put RTP on a
# connection-oriented transport. That buys the client a packet boundary, a
# sequence number and a 48kHz timestamp for free -- exactly what a jitter buffer
# wants -- and it is the same payload format a later WebRTC path would carry.
#
# Cost on the wire: ~96 kbit/s at the default bitrate (16x less than A1).
# Cost in code:     one longer pipeline here, ~100 lines in the browser.
#
# Ports and the websockify demo bridge are identical to the A1 image, so the two
# can be swapped underneath the same client configuration.
# =============================================================================
ARG BASE_IMAGE=vnc-audio:server
FROM ${BASE_IMAGE}

# opusenc lives in gst-plugins-base on current EL9 builds and in bad-free on
# others; installing bad-free covers both and the assertion below settles it at
# build time rather than leaving a broken pipeline to fail at run time.
# rtpopuspay/rtpstreampay are in gst-plugins-good, already in the base image.
RUN dnf -y install --setopt=install_weak_deps=False \
        gstreamer1-plugins-bad-free \
    && dnf clean all
RUN gst-inspect-1.0 opusenc      > /dev/null && \
    gst-inspect-1.0 rtpopuspay   > /dev/null && \
    gst-inspect-1.0 rtpstreampay > /dev/null

RUN (dnf -y install --setopt=install_weak_deps=False python3-websockify || \
     (dnf -y install --setopt=install_weak_deps=False python3-pip && pip3 install websockify)) && \
    dnf clean all

COPY demo/common/ /srv/demo/common/
COPY demo/a2/     /srv/demo/

COPY server/audio-a2.sh /etc/vnc-audio.d/10-audio-a2.sh
RUN chmod +x /etc/vnc-audio.d/10-audio-a2.sh

# 5900 RFB (from the base) | 5901 the Opus stream | 8080 the demo page
EXPOSE 5900 5901 8080
